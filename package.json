{
	"name": "cyber-truss-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"ct": "pnpm run --filter=./packages/cyber-truss",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539",
	"engines": {
		"node": ">=22.11"
	}
}
