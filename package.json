{
	"name": "cyber-truss-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check-version": "universal-plugin publish check-version --root packages/cyber-truss",
		"check:fix": "biome check --write",
		"ct": "pnpm run --filter=./packages/cyber-truss",
		"knip": "knip",
		"plugin:build": "universal-plugin plugin build --root packages/cyber-truss",
		"plugin:check": "universal-plugin plugin build --check --root packages/cyber-truss",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm plugin:check && pnpm check-version && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8",
		"universal-plugin": "0.24.0"
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"engines": {
		"node": ">=22.11"
	}
}
